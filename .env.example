# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_release_notifier

# GitHub API (To create: https://github.com/settings/tokens)
GITHUB_TOKEN=

# SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=onboarding@resend.dev

APP_URL=http://localhost:3000

# How often the scanner checks for new releases (in minutes)
SCAN_INTERVAL_MINUTES=5

API_KEY=
