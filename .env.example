# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
LOGSTASH_HTTP_URL=

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_release_notifier

# GitHub API (To create: https://github.com/settings/tokens)
GITHUB_TOKEN=

# Internal services
NOTIFIER_SERVICE_URL=http://localhost:3002

# Message broker (RabbitMQ)
RABBITMQ_URL=amqp://localhost:5672

APP_URL=http://localhost:3000

# How often the scanner checks for new releases (in minutes)
SCAN_INTERVAL_MINUTES=5

API_KEY=
