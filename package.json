{
  "name": "github-release-notifier",
  "version": "1.0.0",
  "description": "GitHub release notification service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "sh scripts/run-integration-tests.sh",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright install chromium && playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@fastify/static": "^7.0.3",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@prisma/client": "^5.22.0",
    "amqplib": "^0.10.4",
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "node-cron": "^3.0.3",
    "pino": "^8.19.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3",
    "vitest": "^1.4.0"
  }
}
